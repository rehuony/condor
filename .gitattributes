# Keep every checkout byte-for-byte the same as the repository, whatever each
# host's git config says. `text=auto` stores text as LF; the explicit `eol=lf`
# entries keep it LF in the working tree too.
#
# Agent and controller digests (`content_digest` in condor/layering.py,
# `source_digest` in condor/agent_controllers.py) normalize line endings
# themselves, so these rules are about consistency, not correctness of a hash.
* text=auto

# Agent content and config, read and compared as written.
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Executed by a POSIX shell; a CRLF copy fails with a bad-interpreter error.
*.sh text eol=lf
Makefile text eol=lf

# Lock files are written by uv and npm; collapse them in reviewed diffs.
uv.lock linguist-generated=true
frontend/package-lock.json linguist-generated=true

# Binary, so git must not touch them.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
