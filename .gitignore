# ── Python: bytecode, builds and tool caches ──
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
*.egg
.eggs/
wheels/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
coverage.xml
.cache
*.log

# ── Environments and secrets ──
.venv
venv/
env/
.env
# Every .env variant, not just the bare name: a `.env.bak-telegram` written by
# a config switcher once carried a live OpenRouter key into a commit.
.env.*
!.env.example
*.bak-telegram

# ── Local config and runtime data (this deployment's, not the codebase's) ──
# The setup template is source, not runtime state.
config.yml
config.yml.bak
!templates/config.yml
audit_log.yml
data/
# One root for everything this deployment knows about its users (FEAT-051).
.condor/
# Retired runtime locations; keep any old local data out of version control.
condor/.runtime/
condor_bot_data.pickle
condor_bot_data.pickle.bak
/reports/
# Per-assistant stores are runtime; assistants/{name}/AGENT.md is tracked.
assistants/*/store/

# ── Frontend ──
node_modules/
# build_frontend swaps dist.new into place and keeps dist.old as a rollback;
# `dist/` above matches neither, and a dirty tree can block an update.
frontend/dist.new/
frontend/dist.old/

# ── Editors, AI assistants and OS ──
.idea/
.cursor/
.gemini/
.claude/
frontend/.claude/
.codegraph/
.playwright-mcp/
.DS_Store

# ── Local scratch ──
/improvements/
/features/
# Screenshots from debugging sessions; the dashboard's images live in frontend/.
/*.png
# Gateway defect notes edited by several sessions at once; tracking it let
# `git add -A` sweep one session's edits into another's commit (1529d04).
GATEWAY_ISSUES.md
